# Copy this file to .env locally. Never commit .env.
REMOTE_LOCK_OWNER=Innygr
REMOTE_LOCK_PASSWORD=replace-with-a-long-random-secret
# Exact HTTPS origin of the published dashboard, without a trailing slash.
REMOTE_LOCK_ALLOWED_ORIGIN=https://YOUR-USERNAME.github.io
# Bind locally and expose only through a verified Tailscale Serve configuration.
REMOTE_LOCK_HOST=127.0.0.1
REMOTE_LOCK_PORT=8787
REMOTE_LOCK_STATE_FILE=./data/state.json

# Optional until an agent is installed. Use a DIFFERENT random 32+ character token for each device.
REMOTE_LOCK_AGENT_PC_TOKEN=replace-with-a-unique-random-pc-agent-token
REMOTE_LOCK_AGENT_SERVER_TOKEN=replace-with-a-different-random-server-agent-token
